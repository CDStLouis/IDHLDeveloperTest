@inherits OwningComponentBase
@using IDHLDeveloperTest.Models;
@using IDHLDeveloperTest.Services;

<h3>All Characters</h3>


<div style="padding: 10px;">
    <input @bind="searchText" @bind:event="oninput" @bind:after="FilterByName" placeholder="Search by character name" />    
    <TablePagination 
        CurrentPage="@currentPage" 
        TotalPages="@totalPages" 
        OnChangePage="ChangePage">
    </TablePagination>
    <p class="pageStatus">@pageStatus</p>
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var character in characters.Data)
            {
                <tr>
                    <td>@character.Id</td>
                    <td><NavLink href="@($"/character-information/{@character.Id}")">@character.Name</NavLink></td>
                    <td><img class="characterImage" src="@character.ImageUrl"/></td>
                </tr>
            }
        </tbody>
    </table>
    <TablePagination 
        CurrentPage="@currentPage" 
        TotalPages="@totalPages" 
        OnChangePage="ChangePage">
    </TablePagination>
</div>

@code {
    protected IClientService clientService;
    private CharacterList characters = new CharacterList();
    private int currentPage = 1;
    private int totalPages = 0;
    private string searchText = "";
    private string pageStatus =  "Page: 1";

    protected override async Task OnInitializedAsync()
    {
        clientService = (IClientService)ScopedServices.GetService(typeof(IClientService));
        characters = await clientService.GetCharacters(1);
        totalPages = characters.Info.TotalPages;
    }

    private async Task ChangePage(int page)
    {
        currentPage = page;
        pageStatus = $"Page:{page}";
        characters = await clientService.GetCharacters(page);
        searchText = "";        
    }

    private async Task FilterByName()
    {
        if (searchText != "")
        {
            pageStatus = $"All Pages";
            characters = await clientService.GetCharactersByName(searchText);
        }
        else
        {
            searchText = "";
            pageStatus = "Page: 1";
            characters = await clientService.GetCharacters(1);
        }
    }
}
